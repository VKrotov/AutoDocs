<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базова системна тема-обгортка: весь UI малюється в Compose (ui.theme.AutoDocsTheme),
         ця тема потрібна лише для вікна активності до першого кадру Compose. -->
    <style name="Theme.AutoDocs" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
